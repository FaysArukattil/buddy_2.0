<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!--
      Row 1: Brand Header Row (App Icon + "Buddy" on left, Date Badge on right)
      "Buddy" is on its OWN line with full width, so it NEVER gets cut or squeezed!
    -->
    <LinearLayout
        android:id="@+id/layout_brand_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- Buddy Wordmark (takes all remaining space, never wraps) -->
        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="Buddy"
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Date / Today Badge on right -->
        <TextView
            android:id="@+id/tv_today_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tab_active"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Today"
            android:textColor="@color/widget_tab_active_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      Row 2: Tab Selector Row (min 36dp)
      Full width segmented bar: [ Today | Month | Donut | Heatmap ]
      In 3x2: GONE (since only Today is used)
      In 4x2: VISIBLE, but only Today and Month are shown (Donut & Heatmap GONE)
      In 3x3 / 4x4: VISIBLE, all 4 tabs shown!
    -->
    <LinearLayout
        android:id="@+id/layout_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_stat_tile_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Tab 0: Today -->
        <LinearLayout
            android:id="@+id/tab_btn_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_active"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_tab_today_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_today" />

            <TextView
                android:id="@+id/tv_tab_today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Today"
                android:textColor="@color/widget_tab_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 1: Month -->
        <LinearLayout
            android:id="@+id/tab_btn_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_tab_month_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_month" />

            <TextView
                android:id="@+id/tv_tab_month_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Month"
                android:textColor="@color/widget_tab_inactive_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Donut -->
        <LinearLayout
            android:id="@+id/tab_btn_donut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_tab_donut_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_donut" />

            <TextView
                android:id="@+id/tv_tab_donut_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Donut"
                android:textColor="@color/widget_tab_inactive_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Heatmap -->
        <LinearLayout
            android:id="@+id/tab_btn_heatmap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/iv_tab_heatmap_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_heatmap" />

            <TextView
                android:id="@+id/tv_tab_heatmap_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Heatmap"
                android:textColor="@color/widget_tab_inactive_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Multi-Page ViewFlipper: Today(0), Month(1), Donut(2), Heatmap(3) -->
    <ViewFlipper
        android:id="@+id/flipper_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/widget_buddy_page_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_month"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_donut"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_heatmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>

    <!-- Row 4: Pinned Add Button -->
    <LinearLayout
        android:id="@+id/btn_widget_add"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_btn_add"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add" />

        <TextView
            android:id="@+id/tv_btn_add_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Add Transaction"
            android:textColor="@color/widget_accent_text"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

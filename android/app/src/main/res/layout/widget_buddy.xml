<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- 1. Header: Big Buddy Icon & Wordmark + Big Segmented Tab Switcher (min 40dp) -->
    <LinearLayout
        android:id="@+id/layout_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Brand Container (Icon + Wordmark) -->
        <LinearLayout
            android:id="@+id/layout_brand_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 40dp Rounded Squircle Icon -->
            <FrameLayout
                android:id="@+id/container_app_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_squircle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_brand_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="Buddy"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_today_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Today"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Big Segmented Capsule Tab Bar (min 40dp height) -->
        <LinearLayout
            android:id="@+id/layout_tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_stat_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- Tab 0: Today -->
            <LinearLayout
                android:id="@+id/tab_btn_today"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_tab_active"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_tab_today_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tab_today" />

                <TextView
                    android:id="@+id/tv_tab_today_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Today"
                    android:textColor="@color/widget_tab_active_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 1: Month -->
            <LinearLayout
                android:id="@+id/tab_btn_month"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_tab_inactive"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_tab_month_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tab_month" />

                <TextView
                    android:id="@+id/tv_tab_month_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Month"
                    android:textColor="@color/widget_tab_inactive_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: Donut -->
            <LinearLayout
                android:id="@+id/tab_btn_donut"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_tab_inactive"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_tab_donut_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tab_donut" />

                <TextView
                    android:id="@+id/tv_tab_donut_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Donut"
                    android:textColor="@color/widget_tab_inactive_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 3: Heatmap -->
            <LinearLayout
                android:id="@+id/tab_btn_heatmap"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_tab_inactive"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_tab_heatmap_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tab_heatmap" />

                <TextView
                    android:id="@+id/tv_tab_heatmap_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Heatmap"
                    android:textColor="@color/widget_tab_inactive_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Multi-Page ViewFlipper: Today (0), Month (1), Donut (2), Heatmap (3) -->
    <ViewFlipper
        android:id="@+id/flipper_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/widget_buddy_page_today"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_month"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_donut"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <include
            layout="@layout/widget_buddy_page_heatmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>

    <!-- 3. Full-Width Pinned Add Button (min 44dp height) -->
    <LinearLayout
        android:id="@+id/btn_widget_add"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_add"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add" />

        <TextView
            android:id="@+id/tv_btn_add_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Add Transaction"
            android:textColor="@color/widget_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

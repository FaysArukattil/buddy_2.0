<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 Quick Add Widget
  Seamless clean card (zero nested bezels).
  Prominent 68dp Buddy app icon + Add Transaction action.
  Tapping anywhere opens the instant transparent add modal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Prominent App Icon (68dp) -->
    <ImageView
        android:id="@+id/iv_small_app_logo"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <!-- Centered Add Emblem & Action Text -->
    <LinearLayout
        android:id="@+id/btn_widget_add_hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Add Transaction"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="Tap to record"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp" />

</LinearLayout>

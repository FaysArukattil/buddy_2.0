<?xml version="1.0" encoding="utf-8"?>
<!--
  Single Row 2-Column Pill Widget (Smallest Form Factor)
  Left Column: Prominent circular + Quick-Add Button.
  Right Column: 3 stacked rows for Today: Spent, Earned, and Net Balance.
  Tapping + opens instant add modal; tapping stats opens main app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <!-- Column 1: Circular + Quick-Add Button / Logo (Left side) -->
    <FrameLayout
        android:id="@+id/btn_widget_add_small"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_btn_add_circle"
        android:clickable="true"
        android:contentDescription="Add Transaction"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <!-- Column 2: 3 Stacked Rows (Spent, Earned, Balance) (Right side) -->
    <LinearLayout
        android:id="@+id/layout_small_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Row 1: Spent (Today) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/widget_circle_spent"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_widget_arrow_up"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_small_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Earned (Today) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/widget_circle_earned"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_widget_arrow_down"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_small_earned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Balance (Today's Net Total: Color coordinated + green / - red) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Positive balance indicator (Green) -->
            <ImageView
                android:id="@+id/iv_small_balance_pos"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/widget_circle_balance_pos"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_widget_wallet"
                android:tint="#FFFFFFFF"
                android:visibility="visible" />

            <!-- Negative balance indicator (Red) -->
            <ImageView
                android:id="@+id/iv_small_balance_neg"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/widget_circle_balance_neg"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_widget_wallet"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_small_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/widget_income"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

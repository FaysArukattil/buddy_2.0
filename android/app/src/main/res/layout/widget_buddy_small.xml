<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 Quick Add Widget
  Shows ONLY the Add Transaction button with clean Buddy branding.
  Tapping anywhere on the 2×2 widget opens the instant transparent add modal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Big Full-Widget Add Transaction Hero Button -->
    <LinearLayout
        android:id="@+id/btn_widget_add_hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_add"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- App Icon: clean 30dp launcher icon -->
        <ImageView
            android:id="@+id/iv_small_app_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- + Add Emblem -->
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Add Transaction"
            android:textColor="@color/widget_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Tap to record"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>

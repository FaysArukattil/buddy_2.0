<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_donut"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Sub-Header: Segmented Control [ Spending | Earning ] (min 40dp tall) -->
    <LinearLayout
        android:id="@+id/layout_donut_toggle_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_stat_tile_bg"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- Spending Button -->
            <TextView
                android:id="@+id/btn_donut_spending"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Spending"
                android:textColor="@color/widget_tab_active_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Earning Button -->
            <TextView
                android:id="@+id/btn_donut_earning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tab_inactive"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Earning"
                android:textColor="@color/widget_tab_inactive_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native Canvas Donut Slot: Fills remaining height/width with transparent background -->
    <FrameLayout
        android:id="@+id/container_donut_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/iv_stats_donut"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Category Donut Chart"
            android:scaleType="fitCenter" />
    </FrameLayout>

</LinearLayout>
